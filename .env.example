# Default: native Ollama running on the host (recommended, especially on
# macOS, for Metal GPU acceleration). Only used inside the `app` container;
# host-side scripts (make generate-data, make ingest, etc.) already use
# http://localhost:11434 directly.
OLLAMA_URL=http://host.docker.internal:11434
# If you instead run `make up-with-ollama` (containerized Ollama), use:
# OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=600
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=fitcoach_knowledge
DATABASE_URL=postgresql://fitcoach:fitcoach@postgres:5432/fitcoach
SEARCH_STRATEGY=hybrid
PROMPT_TEMPLATE=detailed
RAG_TOP_K=5
